{
	"servers": {
		"awsDiscovery": {
			"type": "stdio",
			"command": "node",
			"args": [
				"${workspaceFolder}/scripts/run-with-env.mjs",
				"node",
				"${workspaceFolder}/dist/mcp/aws-discovery/src/index.js"
			],
			"env": {
				"LOG_LEVEL": "info",
				"MIGRATION_PROJECT_ROOT": "${workspaceFolder}",
				"MIGRATION_RUNS_DIR": "${workspaceFolder}/runs"
			}
		},
		"infrastructureGraph": {
			"type": "stdio",
			"command": "node",
			"args": [
				"${workspaceFolder}/scripts/run-with-env.mjs",
				"node",
				"${workspaceFolder}/dist/mcp/graph-agent/src/index.js"
			],
			"env": {
				"LOG_LEVEL": "info",
				"MIGRATION_PROJECT_ROOT": "${workspaceFolder}",
				"MIGRATION_RUNS_DIR": "${workspaceFolder}/runs"
			}
		},
		"migrationAnalysis": {
			"type": "stdio",
			"command": "node",
			"args": [
				"${workspaceFolder}/scripts/run-with-env.mjs",
				"node",
				"${workspaceFolder}/dist/mcp/migration-agent/src/index.js"
			],
			"env": {
				"LOG_LEVEL": "info",
				"MIGRATION_PROJECT_ROOT": "${workspaceFolder}",
				"MIGRATION_RUNS_DIR": "${workspaceFolder}/runs"
			}
		},
		"migrationPlanner": {
			"type": "stdio",
			"command": "node",
			"args": [
				"${workspaceFolder}/scripts/run-with-env.mjs",
				"node",
				"${workspaceFolder}/dist/mcp/planner-agent/src/index.js"
			],
			"env": {
				"LOG_LEVEL": "info",
				"MIGRATION_PROJECT_ROOT": "${workspaceFolder}",
				"MIGRATION_RUNS_DIR": "${workspaceFolder}/runs"
			}
		},
		"awsPricing": {
			"type": "stdio",
			"command": "node",
			"args": [
				"${workspaceFolder}/scripts/run-with-env.mjs",
				"uvx",
				"--from",
				"awslabs.aws-pricing-mcp-server@latest",
				"awslabs.aws-pricing-mcp-server.exe"
			],
			"env": {
				"FASTMCP_LOG_LEVEL": "ERROR"
			}
		},
		"awsApi": {
			"type": "stdio",
			"command": "node",
			"args": [
				"${workspaceFolder}/scripts/run-with-env.mjs",
				"uvx",
				"--with",
				"mcp>=1.23,<2",
				"--from",
				"awslabs.aws-api-mcp-server==1.5.4",
				"awslabs.aws-api-mcp-server.exe"
			],
			"env": {
				"AWS_API_MCP_WORKING_DIR": "${workspaceFolder}/runs"
			}
		}
	}
}

