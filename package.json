{
  "name": "aws-migration-mvp",
  "version": "0.1.0",
  "description": "AWS Infrastructure Discovery MVP — read-only agent for infrastructure analysis",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "doctor": "node scripts/bootstrap.mjs --check-only",
    "env:configure": "node scripts/configure-env.mjs",
    "env:check": "node scripts/configure-env.mjs --check",
    "setup": "npm ci && npm run build",
    "build": "tsc --build",
    "build:watch": "tsc --build --watch",
    "test": "node --experimental-vm-modules --max-old-space-size=2048 node_modules/jest/bin/jest.js --runInBand --workerIdleMemoryLimit=512MB --testPathPattern=\"tests/unit\"",
    "test:integration": "node --experimental-vm-modules --max-old-space-size=2048 node_modules/jest/bin/jest.js --runInBand --workerIdleMemoryLimit=512MB --testPathPattern=tests/integration",
    "test:all": "node --experimental-vm-modules --max-old-space-size=2048 node_modules/jest/bin/jest.js --runInBand --workerIdleMemoryLimit=512MB",
    "mcp:dev": "ts-node --esm mcp/aws-discovery/src/index.ts",
    "mcp:start": "node mcp/aws-discovery/dist/index.js",
    "graph:dev": "ts-node --esm mcp/graph-agent/src/index.ts",
    "migration:dev": "ts-node --esm mcp/migration-agent/src/index.ts",
    "api:dev": "ts-node --esm api/main.ts",
    "api:start": "node dist/api/main.js",
    "agents:install": "node scripts/install-agents.mjs",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.893.0",
    "@aws-sdk/client-cloudfront": "^3.893.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.893.0",
    "@aws-sdk/client-config-service": "^3.893.0",
    "@aws-sdk/client-dynamodb": "^3.893.0",
    "@aws-sdk/client-ec2": "^3.893.0",
    "@aws-sdk/client-ecr": "^3.893.0",
    "@aws-sdk/client-ecs": "^3.893.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.893.0",
    "@aws-sdk/client-elasticache": "^3.893.0",
    "@aws-sdk/client-iam": "^3.893.0",
    "@aws-sdk/client-lambda": "^3.893.0",
    "@aws-sdk/client-rds": "^3.893.0",
    "@aws-sdk/client-resource-explorer-2": "^3.893.0",
    "@aws-sdk/client-resource-groups-tagging-api": "^3.893.0",
    "@aws-sdk/client-route-53": "^3.893.0",
    "@aws-sdk/client-s3": "^3.893.0",
    "@aws-sdk/client-secrets-manager": "^3.893.0",
    "@aws-sdk/client-sns": "^3.893.0",
    "@aws-sdk/client-sqs": "^3.893.0",
    "@aws-sdk/client-sts": "^3.893.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "winston": "3.17.0",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "22.15.34",
    "jest": "29.7.0",
    "ts-jest": "29.4.0",
    "ts-node": "10.9.2",
    "typescript": "5.8.3"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "domain/**/*.ts",
      "infrastructure/**/*.ts",
      "repositories/**/*.ts",
      "mcp/**/*.ts",
      "!**/*.d.ts"
    ],
    "maxWorkers": 1
  }
}