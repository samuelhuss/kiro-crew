# Copy to .env and adjust. The MCP startup wrapper loads this file for VS Code,
# Cursor, Kiro and the API/CLI processes started through this repository.

# ── AWS credentials (SOURCE account) ─────────────────────────────────────────
# Option A (recommended for daily use): named profiles from ~/.aws/credentials.
# You can point each clone/run at different accounts without editing the agent config.
AWS_PROFILE=migration-source
AWS_REGION=us-east-1

# Optional alias accepted by scripts/run-with-env.mjs. AWS_PROFILE wins if both are set.
# MIGRATION_SOURCE_PROFILE=migration-source

# Option B: static/STS keys. NEVER commit real values. When these are set, the
# wrapper creates a repo-local .aws/credentials profile named migration-source.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ── AWS credentials (TARGET account, cross-account migrations only) ──────────
# Use a separate target profile so you can switch target accounts by editing .env.
AWS_PROFILE_TARGET=migration-target
AWS_REGION_TARGET=sa-east-1
MIGRATION_TARGET_ACCOUNT_ID=

# Optional alias accepted by scripts/run-with-env.mjs. AWS_PROFILE_TARGET wins if both are set.
# MIGRATION_TARGET_PROFILE=migration-target

# Raw target keys also generate a repo-local .aws/credentials profile named migration-target.
# AWS_ACCESS_KEY_ID_TARGET=
# AWS_SECRET_ACCESS_KEY_TARGET=
# AWS_SESSION_TOKEN_TARGET=

# ── AWS Outposts target metadata (optional) ──────────────────────────────────
# Use when the target workload account consumes Outposts resources shared from
# a Landing Zone core/shared-services account. We do NOT require credentials for
# the core account; all AWS API calls are made with migration-target. The core
# account id below is metadata only, useful for reports and validation requests.
OUTPOSTS_CORE_ACCOUNT_ID=
TARGET_OUTPOST_ARN=

# ── Where artifacts are saved ────────────────────────────────────────────────
# Every execution creates runs/<project>/<timestamp>-<account>-<region>/ containing
# run.json, inventory/, graph/, cfn/ and docs/migration-manifest.md.
# Absolute path, or relative to the repo root. Default: <repo>/runs
MIGRATION_RUNS_DIR=./runs

# Pin the repo root when the MCP servers are started from another directory.
# MIGRATION_PROJECT_ROOT=

# Pin a FIXED directory per artifact kind instead of the per-run folders.
# Leave unset for normal use — these override the run folder.
# INVENTORY_DIR=
# TOTAL_INVENTORY_DIR=
# GRAPH_DIR=
# CFN_DIR=
# DOCS_DIR=

# Use ephemeral in-memory stores instead of files (tests / CI).
# MIGRATION_STORE=memory

# ── Tooling ──────────────────────────────────────────────────────────────────
# Full path to cfn-lint if it is not on PATH (pip install cfn-lint)
# CFN_LINT_PATH=

LOG_LEVEL=info

# ── Migration console API (api/main.ts) ──────────────────────────────────────
PORT=3000
HOST=127.0.0.1

# Where the console persists the orchestrator agent config it edits.
# Default: ~/.kiro/agents/aws-migration-orchestrator.json
# ORCHESTRATOR_CONFIG=

# Where the console writes the migration-source / migration-target AWS profiles.
# Default: ~/.aws
# AWS_PROFILE_DIR=
